+def finish_forwarded_request(task, request_id, waiters, failures):
+    """Surface a failed completion writer even when the DB cannot record FAILED.
+
+    Keep the terminal error for later retrieval/retries in this API process.
+    Existing waiters are resolved directly, without needing a working DB poller.
+    """
+    if task.cancelled():
+        return
+    error = task.exception()  # Retrieve it; never leave an orphan task error.
+    if error is None:
+        return
+    logger.error(
+        "Forwarded request %s could not persist its result: %s",
+        request_id, error, exc_info=(type(error), error, error.__traceback__),
+    )
+    outcome = (
+        RequestStatus.FAILED,
+        types.ErrorResponse(
+            error=f"Server could not persist sampling result {request_id}: {type(error).__name__}: {error}",
+            status="failed",
+        ).model_dump_json(),
+    )
+    failures[request_id] = outcome
+    for waiter in waiters.pop(request_id, ()):
+        if not waiter.done():
+            waiter.set_result(outcome)
 
 
